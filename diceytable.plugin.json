{
  "schemaVersion": "1.0",
  "id": "community.swtcg-deckdb",
  "name": "SWTCG Deck Database",
  "version": "1.2.0",
  "breakingVersion": 1,
  "summary": "Star Wars TCG card data and decklists from swtcg-deckdb.com.",
  "description": "Card data and public decklists from the community-run Star Wars TCG Deck Database.\n\nThe whole card database (10,891 cards) is published as one static document with no search endpoint, so it is declared as a scheduled catalogue endpoint: the platform reads it a few times a day, normalizes it once, and the deck builder searches it locally. Card art is composed from each record's set code and image fragment against the LackeyCCG image repository on GitHub, because the provider stores those two parts separately and never an absolute URL.\n\nOnly public decks are readable. Nothing is written back, and no viewer identity is sent upstream.",
  "compatibility": {
    "engine": ">=0.1 <1.0"
  },
  "capabilities": {
    "version": "1",
    "allowed": [
      "network"
    ]
  },
  "origins": [
    "swtcg-deckdb.com",
    "raw.githubusercontent.com"
  ],
  "endpoints": [
    {
      "name": "deckById",
      "origin": "swtcg-deckdb.com",
      "method": "GET",
      "path": "/api/decks/{deckId}",
      "params": [
        {
          "name": "deckId",
          "location": "path",
          "format": "token",
          "required": true,
          "description": "The 6-character deck id from a /deck/<id> permalink."
        }
      ],
      "auth": {
        "kind": "none"
      },
      "returns": "raw",
      "description": "One public deck: main list plus supply."
    },
    {
      "name": "publicDecks",
      "origin": "swtcg-deckdb.com",
      "method": "GET",
      "path": "/api/decks",
      "params": [],
      "auth": {
        "kind": "none"
      },
      "returns": "raw",
      "description": "Summaries of every public deck. Card lists are not included."
    },
    {
      "name": "starterDecks",
      "origin": "swtcg-deckdb.com",
      "method": "GET",
      "path": "/api/starters",
      "params": [],
      "auth": {
        "kind": "none"
      },
      "returns": "raw",
      "description": "The official starter decks, with full card lists."
    },
    {
      "name": "userDecks",
      "origin": "swtcg-deckdb.com",
      "method": "GET",
      "path": "/api/users/{userId}/decks",
      "params": [
        {
          "name": "userId",
          "location": "path",
          "format": "token",
          "required": true,
          "description": "Opaque user id, as it appears on a deck summary's owner_id."
        }
      ],
      "auth": {
        "kind": "none"
      },
      "returns": "raw",
      "description": "A user's public decks. Their private decks are never included."
    },
    {
      "name": "cardDecks",
      "origin": "swtcg-deckdb.com",
      "method": "GET",
      "path": "/api/card-decks",
      "params": [
        {
          "name": "name",
          "location": "query",
          "format": "text",
          "required": true,
          "maxLength": 200,
          "description": "Exact card name."
        },
        {
          "name": "set",
          "location": "query",
          "format": "token",
          "required": true,
          "description": "Set code, e.g. AOTC."
        }
      ],
      "auth": {
        "kind": "none"
      },
      "returns": "raw",
      "description": "Public decks that contain one specific card."
    },
    {
      "name": "cardRatings",
      "origin": "swtcg-deckdb.com",
      "method": "GET",
      "path": "/api/card-ratings",
      "params": [
        {
          "name": "name",
          "location": "query",
          "format": "text",
          "required": true,
          "maxLength": 200,
          "description": "Exact card name."
        },
        {
          "name": "set",
          "location": "query",
          "format": "token",
          "required": true,
          "description": "Set code, e.g. AOTC."
        }
      ],
      "auth": {
        "kind": "none"
      },
      "returns": "raw",
      "description": "Community rating summary for one card."
    },
    {
      "name": "cardRatingsBulk",
      "origin": "swtcg-deckdb.com",
      "method": "GET",
      "path": "/api/card-ratings/bulk",
      "params": [],
      "auth": {
        "kind": "none"
      },
      "returns": "raw",
      "description": "Rating summary for every rated card, keyed name|set."
    },
    {
      "name": "tournaments",
      "origin": "swtcg-deckdb.com",
      "method": "GET",
      "path": "/api/tournaments",
      "params": [],
      "auth": {
        "kind": "none"
      },
      "returns": "raw",
      "description": "Every tournament, ongoing and archived."
    },
    {
      "name": "tournamentById",
      "origin": "swtcg-deckdb.com",
      "method": "GET",
      "path": "/api/tournaments/{tournamentId}",
      "params": [
        {
          "name": "tournamentId",
          "location": "path",
          "format": "token",
          "required": true,
          "description": "Opaque tournament id, as it appears in a deck's placements."
        }
      ],
      "auth": {
        "kind": "none"
      },
      "returns": "raw",
      "description": "One tournament with its entrants and their decks."
    },
    {
      "name": "providerStatus",
      "origin": "swtcg-deckdb.com",
      "method": "GET",
      "path": "/api/config",
      "params": [],
      "auth": {
        "kind": "none"
      },
      "returns": "raw",
      "description": "Liveness probe. Returns a single debug flag."
    },
    {
      "name": "cardCatalogue",
      "origin": "swtcg-deckdb.com",
      "method": "GET",
      "path": "/static/cards.json",
      "params": [],
      "auth": {
        "kind": "none"
      },
      "returns": "catalogue",
      "description": "The entire card database in one document. Read on a schedule, never per player."
    }
  ],
  "deckImport": {
    "endpoint": "deckById",
    "param": "deckId",
    "label": "Deck id or swtcg-deckdb.com link",
    "matchField": "name",
    "namePath": "name",
    "root": "cards",
    "entry": {
      "count": {
        "path": "count",
        "transforms": [
          "number"
        ],
        "default": 1,
        "required": false
      },
      "match": {
        "path": "name",
        "transforms": [
          "trim"
        ],
        "required": true
      }
    },
    "partitions": [
      {
        "root": "supply",
        "partitionId": "supply"
      }
    ]
  },
